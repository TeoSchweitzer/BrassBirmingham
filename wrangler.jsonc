{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brass-birmingham-online",
  "main": "server/index.ts",
  "compatibility_date": "2026-05-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*"]
  }
}

